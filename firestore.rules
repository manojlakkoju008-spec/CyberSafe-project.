rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Root administrator or verified admin record
    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'manojlakkoju008@gmail.com' ||
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'SUPER_ADMIN' &&
         get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.status == 'active')
      );
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'manojlakkoju008@gmail.com' ||
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.status != 'suspended')
      );
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'status', 'createdAt', 'lastLoginAt', 'userType', 'completedChecklistIds', 'savedThreatIds', 'savedBasicIds', 'quizHistory']) &&
        data.uid is string && data.uid.size() <= 128 &&
        data.email is string && data.email.size() <= 256 &&
        data.displayName is string && data.displayName.size() <= 100 &&
        data.role in ['admin', 'educator', 'member', 'guest'];
    }

    // ==========================================
    // USER COLLECTION RULES
    // ==========================================
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      
      allow create: if isValidId(userId) && isOwner(userId) && isValidUser(incoming()) &&
        incoming().uid == userId &&
        (incoming().role == 'member' || isAdmin());
        
      allow update: if isValidId(userId) && (
        (isOwner(userId) && isValidUser(incoming()) && incoming().uid == existing().uid && (incoming().role == existing().role || isAdmin())) ||
        isAdmin()
      );

      allow delete: if isValidId(userId) && (isOwner(userId) || isSuperAdmin());

      // User quiz records subcollection
      match /quizRecords/{recordId} {
        allow get, list: if isValidId(recordId) && (isOwner(userId) || isAdmin());
        allow create: if isValidId(recordId) && isOwner(userId) &&
          incoming().userId == userId &&
          incoming().score is number && incoming().total is number;
        allow update, delete: if isValidId(recordId) && (isOwner(userId) || isAdmin());
      }
    }

    // ==========================================
    // ADMINISTRATOR DIRECTORY & RBAC
    // ==========================================
    match /admins/{adminId} {
      allow get, list: if isAdmin() && isValidId(adminId);
      allow create, update, delete: if isSuperAdmin() && isValidId(adminId);
    }

    // ==========================================
    // IMMUTABLE AUDIT LOGS (APPEND-ONLY)
    // ==========================================
    match /audit_logs/{logId} {
      allow get, list: if isAdmin() && isValidId(logId);
      allow create: if isAdmin() && isValidId(logId);
      // Immutability: updates and deletes strictly forbidden
      allow update, delete: if false;
    }

    // ==========================================
    // NEARBY HELP LOCATIONS (POLICE, CYBER CELLS)
    // ==========================================
    match /locations/{locationId} {
      allow read: if isValidId(locationId);
      allow write: if isAdmin() && isValidId(locationId);
    }

    // ==========================================
    // PLATFORM ANNOUNCEMENTS
    // ==========================================
    match /announcements/{announcementId} {
      allow read: if isValidId(announcementId);
      allow write: if isAdmin() && isValidId(announcementId);
    }

    // ==========================================
    // SYSTEM & DEFENSIVE SETTINGS
    // ==========================================
    match /system_settings/{settingId} {
      allow read: if isValidId(settingId);
      allow write: if isSuperAdmin() && isValidId(settingId);
    }

    // ==========================================
    // EDUCATIONAL CONTENT COLLECTIONS (ADMIN MANAGED)
    // ==========================================
    
    // Learning Resources (Threats)
    match /content_threats/{threatId} {
      allow read: if isValidId(threatId);
      allow write: if isAdmin() && isValidId(threatId);
    }

    // Prevention Methodologies
    match /content_preventions/{prevId} {
      allow read: if isValidId(prevId);
      allow write: if isAdmin() && isValidId(prevId);
    }

    // Educational Quiz Questions
    match /content_quiz/{quizId} {
      allow read: if isValidId(quizId);
      allow write: if isAdmin() && isValidId(quizId);
    }

    // Emergency & Reporting Guidance
    match /content_reporting/{resourceId} {
      allow read: if isValidId(resourceId);
      allow write: if isAdmin() && isValidId(resourceId);
    }
  }
}

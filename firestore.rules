rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'manojlakkoju008@gmail.com'
      );
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'createdAt', 'lastLoginAt', 'userType', 'completedChecklistIds', 'savedThreatIds']) &&
        data.uid is string && data.uid.size() <= 128 &&
        data.email is string && data.email.size() <= 256 &&
        data.displayName is string && data.displayName.size() <= 100 &&
        data.role in ['admin', 'educator', 'member'];
    }

    // User collection rules
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      
      allow create: if isValidId(userId) && isOwner(userId) && isValidUser(incoming()) &&
        incoming().uid == userId &&
        (incoming().role == 'member' || isAdmin());
        
      allow update: if isValidId(userId) && isOwner(userId) && isValidUser(incoming()) &&
        incoming().uid == existing().uid &&
        (incoming().role == existing().role || isAdmin());

      allow delete: if isValidId(userId) && (isOwner(userId) || isAdmin());

      // User quiz records subcollection
      match /quizRecords/{recordId} {
        allow get, list: if isValidId(recordId) && (isOwner(userId) || isAdmin());
        allow create: if isValidId(recordId) && isOwner(userId) &&
          incoming().userId == userId &&
          incoming().score is number && incoming().total is number;
        allow update, delete: if isValidId(recordId) && (isOwner(userId) || isAdmin());
      }
    }

    // Whitelisted administrators
    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId);
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin() && isValidId(adminId);
    }
  }
}
